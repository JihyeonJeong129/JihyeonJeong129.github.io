<style>
.cert-line {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1px dashed #ccc;
  padding: 0.75rem 0;
  gap: 1rem;
  flex-wrap: wrap;
}

.cert-line .left {
  display: flex;
  align-items: center;
  flex: 1 1 auto;
  min-width: 0;
}

.cert-line i {
  color: #b300b3;
  margin-right: 0.6rem;
  font-size: 1.1rem;
  flex-shrink: 0;
}

.cert-line .text {
  line-height: 1.3;
}

.cert-line .title {
  font-weight: 600;
  color: #b300b3;
}

.cert-line .issuer {
  font-size: 0.9rem;
  color: #555;
}

.cert-line .date {
  font-size: 0.85rem;
  white-space: nowrap;
  color: #666;
  flex-shrink: 0;
}
</style>

<div class="cert-section">
  {% assign certificates = data[1] | sort: 'date' | reverse %}
  {% for cert in certificates %}
    <div class="cert-line">
      <div class="left">
        {% if cert.icon %}
          <i class="{{ cert.icon }}"></i>
        {% endif %}
        <div class="text">
          <div class="title">
            {% capture cert_url %}{% include local_url.liquid url=cert.url %}{% endcapture %}
            <a href="{{ cert_url | strip }}">{{ cert.name }}</a>
          </div>
          <div class="issuer">{{ cert.issuer }}</div>
        </div>
      </div>
      <div class="date">{{ cert.date }}</div>
    </div>
  {% endfor %}
</div>
