{% assign visible_count = 3 %}
{% assign total_courses = data[1] | size %}
<div id="cv-courses" class="cv-expandable collapsed">
  {% for course in data[1] %}
    <div class="course-entry{% if forloop.index > visible_count %} cv-extra{% endif %}">
      <div class="course-title">
        {% if course.url %}
          {% capture course_url %}{% include local_url.liquid url=course.url %}{% endcapture %}
          <a href="{{ course_url | strip }}" target="_blank" rel="noopener noreferrer">{{ course.name }}</a>
        {% else %}
          {{ course.name }}
        {% endif %}
      </div>
      <div class="course-date">{{ course.startDate }} ~ {{ course.endDate }}</div>
      {% if course.summary %}
        <div class="course-summary">{{ course.summary }}</div>
      {% endif %}
      {% if course.highlights %}
        <ul class="course-highlights">
          {% for item in course.highlights %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}

  {% if total_courses > visible_count %}
    {% assign more_count = total_courses | minus: visible_count %}
    {% include resume/expandable_toggle.liquid container_id='cv-courses' more_count=more_count %}
  {% endif %}
</div>
