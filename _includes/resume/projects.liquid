<style>
  .cv-project-entry {
    padding: 1rem 0;
    border-bottom: 1px dashed #ccc;
  }

  .cv-project-entry:last-child {
    border-bottom: none;
  }

  .cv-project-title {
    font-weight: 600;
    color: #b300b3;
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }

  .cv-project-summary {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .cv-project-keywords {
    margin-bottom: 0.5rem;
  }

  .cv-project-keywords img {
    margin: 1px 2px;
  }

  .cv-project-highlights {
    font-size: 0.9rem;
    margin-left: 1rem;
    list-style-type: disc;
  }
</style>

<div class="cv-projects">
  {% for content in data[1] %}
    <div class="cv-project-entry">
      <div class="cv-project-title">
        {% if content.url and content.url != '' %}
          {% capture content_url %}{% include local_url.liquid url=content.url %}{% endcapture %}
          <a href="{{ content_url | strip }}">{{ content.name }}</a>
        {% else %}
          {{ content.name }}
        {% endif %}
      </div>
      {% if content.summary %}
        <div class="cv-project-summary">{{ content.summary }}</div>
      {% endif %}
      {% if content.keywords and content.keywords.size > 0 %}
        <div class="cv-project-keywords">
          {% for keyword in content.keywords %}
            {% case keyword %}
              {% when 'MySQL' %}{% assign badgeColor = '4479A1' %}{% assign badgeLogo = 'mysql' %}
              {% when 'Flask' %}{% assign badgeColor = '000000' %}{% assign badgeLogo = 'flask' %}
              {% when 'FastAPI' %}{% assign badgeColor = '009688' %}{% assign badgeLogo = 'fastapi' %}
              {% when 'Qdrant' %}{% assign badgeColor = 'DC244C' %}{% assign badgeLogo = 'qdrant' %}
              {% when 'Ollama' %}{% assign badgeColor = '000000' %}{% assign badgeLogo = 'ollama' %}
              {% else %}{% assign badgeColor = '455A64' %}{% assign badgeLogo = keyword | downcase | remove: ' ' | remove: '.' %}
            {% endcase %}
            <img alt="{{ keyword }}" src="https://img.shields.io/badge/{{ keyword | replace: ' ', '%20' }}-{{ badgeColor }}?style=flat&logo={{ badgeLogo }}&logoColor=white">
          {% endfor %}
        </div>
      {% endif %}
      {% if content.highlights %}
        <ul class="cv-project-highlights">
          {% for item in content.highlights %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}
</div>
