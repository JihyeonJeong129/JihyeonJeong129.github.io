<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% assign current_lang = page.lang | default: 'en' %}

          {% comment %} About: pick Korean version when on a Korean page {% endcomment %}
          {% assign about_url = '/' %}
          {% assign about_title = '' %}
          {% assign about_title_ko = '' %}
          {% for p in site.pages %}
            {% if p.permalink == '/' %}
              {% assign about_title = p.title %}
              {% assign about_title_ko = p.title_ko %}
            {% endif %}
          {% endfor %}
          {% assign about_url_en = '/' %}
          {% assign about_url_ko = '/' %}
          {% assign ko_about = site.pages | where: "ref", "about" | where: "lang", "ko" | first %}
          {% if ko_about %}{% assign about_url_ko = ko_about.url %}{% endif %}
          {% if current_lang == 'ko' %}
            {% if ko_about %}
              {% assign about_url = ko_about.url %}
              {% assign about_title = ko_about.title %}
            {% elsif about_title_ko %}
              {% assign about_title = about_title_ko %}
            {% endif %}
          {% endif %}

          <!-- About -->
          <li class="nav-item {% if page.url == about_url %}active{% endif %}">
            <a class="nav-link" href="{{ about_url | relative_url }}" data-href-en="{{ about_url_en | relative_url }}" data-href-ko="{{ about_url_ko | relative_url }}">
              {{- about_title }}
              {% if page.url == about_url %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% comment %} If on a Korean page, look up the Korean counterpart by ref {% endcomment %}
                {% assign nav_title = p.title %}
                {% assign nav_url = p.url %}
                {% if p.permalink contains '://' %}
                  {% assign nav_url = p.permalink %}
                {% elsif p.permalink contains '/blog/' %}
                  {% assign nav_url = '/blog/' %}
                {% endif %}
                {% assign nav_url_en = nav_url %}
                {% assign nav_url_ko = nav_url %}
                {% if p.ref %}
                  {% assign ko_alt = site.pages | where: "ref", p.ref | where: "lang", "ko" | first %}
                  {% if ko_alt %}{% assign nav_url_ko = ko_alt.url %}{% endif %}
                {% endif %}
                {% if current_lang == 'ko' %}
                  {% if p.ref %}
                    {% if ko_alt %}
                      {% assign nav_title = ko_alt.title %}
                      {% assign nav_url = ko_alt.url %}
                    {% elsif p.title_ko %}
                      {% assign nav_title = p.title_ko %}
                    {% endif %}
                  {% elsif p.title_ko %}
                    {% assign nav_title = p.title_ko %}
                  {% endif %}
                {% endif %}
                {% assign parent_link = nav_url | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  <a class="nav-link" href="{{ nav_url | relative_url }}" data-href-en="{{ nav_url_en | relative_url }}" data-href-ko="{{ nav_url_ko | relative_url }}">
                    {{- nav_title }}
                    {% if page.url contains nav_url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}

          <!-- Divider between main nav and utility icons -->
          <li class="nav-item nav-divider" aria-hidden="true"></li>

          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link"><i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}

          <!-- Language Switcher -->
          {% comment %} Only show when the current page has a translated counterpart {% endcomment %}
          {% if page.ref %}
            {% if current_lang == 'ko' %}
              {% assign target_lang = 'en' %}
              {% assign target_label = 'EN' %}
              {% assign target_full = 'English' %}
            {% else %}
              {% assign target_lang = 'ko' %}
              {% assign target_label = '한국어' %}
              {% assign target_full = '한국어' %}
            {% endif %}

            {% assign all_items = site.posts | concat: site.projects | concat: site.pages %}
            {% assign counterpart = all_items | where: "ref", page.ref | where: "lang", target_lang | first %}

            {% if counterpart %}
              <li class="nav-item">
                <a class="nav-link lang-switch-link" href="{{ counterpart.url | relative_url }}" data-target-lang="{{ target_lang }}" title="Switch to {{ target_full }}" aria-label="Switch language">
                  <span class="lang-switch">{{ target_label }}</span>
                </a>
              </li>
            {% endif %}
          {% endif %}

          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
